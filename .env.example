# Supabase is optional for the local demo fallback.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Leave AI_PROVIDER unset to use deterministic CV analysis and recommendations.
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=20

# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Live scraping remains disabled by default.
ENABLE_LIVE_JOB_SCRAPING=false
ENABLE_LIVE_JOB_INGESTION=false
ENABLE_JOB_INGESTION_ENDPOINT=false
JOB_INGESTION_SOURCES=seed
JOB_INGESTION_MAX_RESULTS=50
JOB_INGESTION_TIMEOUT_SECONDS=10

# Frontend local API base.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
