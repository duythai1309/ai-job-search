SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional — leave empty to run WITHOUT AI features. Non-AI endpoints
# (profile, jobs search, applications, CV CRUD, analytics) work without it;
# AI endpoints return a clear error until a key is set.
GEMINI_API_KEY=
# Cheap-but-capable default. Higher quality: gemini-2.5-flash.
# (gemini-1.5-* and gemini-2.0-flash have been retired by Google.)
GEMINI_MODEL=gemini-2.5-flash-lite

# Firecrawl (hosted scraping) — needed for YBOX / Vieclam24h crawling.
# Get a key at https://firecrawl.dev. Leave empty to disable those sources.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# For local dev set this to http://localhost:3000
FRONTEND_URL=https://your-app.vercel.app
ENVIRONMENT=development
